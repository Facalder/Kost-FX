<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import com.gluonhq.charm.glisten.mvc.View?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import com.gluonhq.charm.glisten.control.Icon?>
<View fx:id="dashboardAddNewKost" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kost.views.DashboardAddNewKostPresenter"
      prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox maxHeight="-Infinity" prefHeight="-Infinity" prefWidth="441.0" spacing="20.0" styleClass="background-blue">
            <children>
                <Label  contentDisplay="TEXT_ONLY" style="-fx-text-fill: white;" text="%label.dashboardAddNewKost.text.title.1" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets top="20" left="20" bottom="20" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="24.0">
            <children>
                <VBox spacing="16.0">
                    <children>
                        <VBox prefWidth="100.0" spacing="8.0">
                            <children>
                                <Label text="%label.dashboardAddNewKost.textField.address">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField styleClass="text-field, text-prompt" fx:id="addressField" promptText="%label.dashboardAddNewKost.textField.address.promptText" />
                            </children>
                        </VBox>
                        <VBox prefWidth="100.0" spacing="8.0">
                            <children>
                                <Label text="%label.dashboardAddNewKost.textField.facilities">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField styleClass="text-field, text-prompt" fx:id="facilitiessField" promptText="%label.dashboardAddNewKost.textField.facilities.promptText" />
                            </children>
                        </VBox>
                        <VBox prefWidth="100.0" spacing="8.0">
                            <children>
                                <Label text="%label.dashboardAddNewKost.textField.price">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField styleClass="text-field, text-prompt" fx:id="priceField" promptText="%label.dashboardAddNewKost.textField.price.promptText" />
                            </children>
                        </VBox>
                        <VBox prefWidth="100.0" spacing="8.0">
                            <children>
                                <Label text="%label.dashboardAddNewKost.textField.totalRoom">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField styleClass="text-field, text-prompt" fx:id="totalRoomField" promptText="%label.dashboardAddNewKost.textField.totalRoom.promptText" />
                            </children>
                        </VBox>
                        <VBox spacing="14.0">
                            <children>
                                <HBox prefWidth="200.0" spacing="16.0">
                                    <children>
                                        <Button mnemonicParsing="false" styleClass="secondary-button" text="%button.dashboardAddNewKost.label.uploadImage">
                                            <graphic>
                                                <Icon content="FILE_UPLOAD" />
                                            </graphic>
                                        </Button>

                                        <Button mnemonicParsing="false" styleClass="danger-button" text="%button.dashboardAddNewKost.label.deleteImage">
                                            <graphic>
                                                <Icon content="DELETE" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                                <HBox spacing="8.0">
                                    <children>
                                        <Label text="Nama File: ">
                                            <font>
                                                <Font size="16" />
                                            </font>
                                        </Label>
                                        <Label text="sdsdsdsd">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <Button mnemonicParsing="false" styleClass="primary-button" text="%button.dashboardAddNewKost.submit.dashboardAddNewKost.1">
                    <graphic>
                        <Icon content="ADD" />
                    </graphic>
                </Button>
            </children>

            <padding>
                <Insets left="16" right="16" top="16"/>
            </padding>
        </VBox>
    </center>
</View>
